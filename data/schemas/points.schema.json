{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ai-management/data/points.json",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "This file's JSON Schema (for editors)."
    }
  },
  "patternProperties": {
    "^[a-z0-9_]{2,32}$": {
      "type": "object",
      "properties": {
        "label": {
          "description": "Name",
          "type": "string",
          "minLength": 1,
          "maxLength": 48
        },
        "type": {
          "description": "For a",
          "enum": [
            "job",
            "gang"
          ]
        },
        "owner": {
          "description": "Job or gang: Its name as set up in the framework settings.",
          "type": "string",
          "minLength": 2,
          "maxLength": 32,
          "pattern": "^[a-z0-9_]{2,32}$"
        },
        "coords": {
          "description": "Place: Stand where the boss opens the menu and use your position.",
          "type": "object",
          "required": [
            "x",
            "y",
            "z"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "z": {
              "type": "number"
            }
          }
        },
        "radius": {
          "description": "Reach",
          "type": "number",
          "minimum": 0.5,
          "maximum": 10
        }
      },
      "required": [
        "label",
        "type",
        "owner",
        "coords",
        "radius"
      ]
    }
  },
  "additionalProperties": false
}
